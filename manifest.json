{
  "manifest_version": 3,
  "name": "视频倍速控制器",
  "version": "1.1.0",
  "description": "在任意网页上可视化控制 HTML5 视频播放速度（0.25x ~ 16x），支持悬浮球图标自定义、滑块、快捷按钮与位置记忆。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
